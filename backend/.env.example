# GTMS Backend Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection (Prisma)
DATABASE_URL="mysql://root:starboy007@localhost:3306/gtms_db"

# JWT Secret Keys
JWT_SECRET=gtms-super-secret-access-token-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gtms-super-secret-refresh-token-key-2026
JWT_REFRESH_EXPIRES_IN=7d

# Security & CORS
CORS_ORIGIN=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMTP Email Dispatcher (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=isaac98solomon1@gmail.com
SMTP_PASS=your-google-app-password-here
EMAIL_FROM="NASFAM GTMS Admin <isaac98solomon1@gmail.com>"
